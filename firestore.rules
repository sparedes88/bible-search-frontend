rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasGlobalAdminRole(userDoc) {
      return userDoc.data.role in ['global_admin', 'system_global_admin'] ||
        userDoc.data.baseRole in ['global_admin', 'system_global_admin'] ||
        userDoc.data.basedOn in ['global_admin', 'system_global_admin'] ||
        userDoc.data.systemRole in ['global_admin', 'system_global_admin'] ||
        hasCustomRoleBase(userDoc, ['global_admin', 'system_global_admin']);
    }

    function hasChurchAdminRole(userDoc) {
      return userDoc.data.role in ['admin', 'system_admin'] ||
        userDoc.data.baseRole in ['admin', 'system_admin'] ||
        userDoc.data.basedOn in ['admin', 'system_admin'] ||
        userDoc.data.systemRole in ['admin', 'system_admin'] ||
        hasCustomRoleBase(userDoc, ['admin', 'system_admin', 'global_admin', 'system_global_admin']);
    }

    function getCustomRoleId(userDoc) {
      return string(
        userDoc.data.customRoleId != null
          ? userDoc.data.customRoleId
          : (
              userDoc.data.assignedRoleId != null
                ? userDoc.data.assignedRoleId
                : (
                    userDoc.data.role != null
                      ? userDoc.data.role
                      : ''
                  )
            )
      );
    }

    function hasCustomRoleBase(userDoc, roleList) {
      let roleId = getCustomRoleId(userDoc);
      return roleId != '' &&
        exists(/databases/$(database)/documents/roles/$(roleId)) &&
        (
          get(/databases/$(database)/documents/roles/$(roleId)).data.baseRole in roleList ||
          get(/databases/$(database)/documents/roles/$(roleId)).data.basedOn in roleList ||
          get(/databases/$(database)/documents/roles/$(roleId)).data.role in roleList ||
          get(/databases/$(database)/documents/roles/$(roleId)).data.systemRole in roleList
        );
    }

    function isSameChurchAsCurrentUser(userData) {
      let currentUser = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.churchId == currentUser.churchId ||
        userData.churchID == currentUser.churchId ||
        userData.organizationId == currentUser.churchId ||
        userData.churchId == currentUser.churchID ||
        userData.churchID == currentUser.churchID ||
        userData.organizationId == currentUser.churchID ||
        userData.churchId == currentUser.organizationId ||
        userData.churchID == currentUser.organizationId ||
        userData.organizationId == currentUser.organizationId;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isGlobalAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isAuthenticated() && hasGlobalAdminRole(userDoc);
    }

    function userBelongsToChurch(churchId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.churchId == churchId ||
        userDoc.data.churchID == churchId ||
        userDoc.data.organizationId == churchId ||
        exists(/databases/$(database)/documents/churches/$(churchId)/members/$(request.auth.uid));
    }

    function isChurchAdmin(churchId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isAuthenticated() && (
        hasGlobalAdminRole(userDoc) ||
        (hasChurchAdminRole(userDoc) && userBelongsToChurch(churchId))
      );
    }

    function isUserInChurch(churchId) {
      return request.auth.uid != null && userBelongsToChurch(churchId);
    }

    function normalizeModulePermissionKey(moduleId) {
      return moduleId == 'conduit-run-counter'
        ? 'conduitruncounter'
        : moduleId == 'time-tracker'
        ? 'timetracker'
        : moduleId == 'pay-everyone'
        ? 'payeveryone'
        : moduleId == 'time-rotate'
        ? 'timerotate'
        : moduleId;
    }

    function roleBelongsToChurch(roleData, churchId) {
      return roleData.churchId == churchId ||
        roleData.churchID == churchId ||
        roleData.organizationId == churchId;
    }

    function hasCustomRoleModulePermission(churchId, moduleId, action) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let roleId = getCustomRoleId(userDoc);
      let normalizedModuleId = normalizeModulePermissionKey(moduleId);

      return isAuthenticated() &&
        roleId != '' &&
        exists(/databases/$(database)/documents/roles/$(roleId)) &&
        roleBelongsToChurch(get(/databases/$(database)/documents/roles/$(roleId)).data, churchId) &&
        ('permissions' in get(/databases/$(database)/documents/roles/$(roleId)).data) &&
        (normalizedModuleId in get(/databases/$(database)/documents/roles/$(roleId)).data.permissions) &&
        (
          get(/databases/$(database)/documents/roles/$(roleId)).data.permissions[normalizedModuleId][action] == true ||
          (
            action in ['create', 'update', 'delete', 'manage'] &&
            get(/databases/$(database)/documents/roles/$(roleId)).data.permissions[normalizedModuleId].manage == true
          ) ||
          (
            action == 'read' &&
            (
              get(/databases/$(database)/documents/roles/$(roleId)).data.permissions[normalizedModuleId].manage == true ||
              get(/databases/$(database)/documents/roles/$(roleId)).data.permissions[normalizedModuleId].create == true ||
              get(/databases/$(database)/documents/roles/$(roleId)).data.permissions[normalizedModuleId].update == true ||
              get(/databases/$(database)/documents/roles/$(roleId)).data.permissions[normalizedModuleId].delete == true
            )
          )
        );
    }

    function canReadModule(churchId, moduleId) {
      return isAuthenticated() && userBelongsToChurch(churchId) && (
        isChurchAdmin(churchId) ||
        hasCustomRoleModulePermission(churchId, moduleId, 'read')
      );
    }

    function canManageModule(churchId, moduleId) {
      return isAuthenticated() && userBelongsToChurch(churchId) && (
        isChurchAdmin(churchId) ||
        hasCustomRoleModulePermission(churchId, moduleId, 'manage') ||
        hasCustomRoleModulePermission(churchId, moduleId, 'create') ||
        hasCustomRoleModulePermission(churchId, moduleId, 'update') ||
        hasCustomRoleModulePermission(churchId, moduleId, 'delete')
      );
    }

    // ✅ Users
    match /users/{userId} {
      // Explicit self document access for AuthContext profile load.
      allow get: if isAuthenticated() && request.auth.uid == userId;

      function isMember() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['member', 'system_member'];
      }

      function isOwner() {
        return request.auth.uid == userId;
      }

      // Allow querying users by churchId for admin connections
      allow list: if isAuthenticated() && 
                  ('churchId' in request.query.filters) &&
                  (userBelongsToChurch(request.query.filters.churchId[0]) || isGlobalAdmin());

      // Allow querying users by phone or email for lookup purposes (event check-in, login, etc)
      allow list: if isAuthenticated() && 
                   (('phone' in request.query.filters) || ('email' in request.query.filters));

      allow read: if isAuthenticated() && isMember() && isOwner();

      allow update: if isAuthenticated() &&
                      isMember() &&
                      isOwner() &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      // Allow authenticated users to create their own profile during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;

      allow read: if isAuthenticated() &&
        (userId == request.auth.uid ||
         isSameChurchAsCurrentUser(resource.data));

      // Allow authenticated users to update their own profile (but not role or churchId)
      allow update: if isAuthenticated() &&
        userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'churchId']);

      allow read, write, delete: if isGlobalAdmin();

      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
    }

    // ✅ Progress Collection
    match /progress/{progressId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isUserInChurch(resource.data.churchId));
      allow write: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ✅ Course Categories
    match /coursecategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isChurchAdmin(request.resource.data.churchId);
    }

      // ✅ Course Topics
      match /coursetopics/{topicId} {
        allow read: if true;
        // Add write rules as needed
      }

    // ✅ Event Instances
    match /eventInstances/{eventId} {
      allow read: if true;
      allow write, delete: if isChurchAdmin(resource.data.churchId);
    }

    // ✅ Events
    match /events/{eventId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && 
        (isChurchAdmin(resource.data.churchId) || isGlobalAdmin());
    }

    // ✅ Churches and Subcollections
    match /churches/{churchId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /broadcasts/{broadcastId} {
        allow read: if true;
        function isPublicBroadcastViewerUpdate() {
          return request.auth == null &&
            resource.data != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'viewerIceCandidate',
              'answer'
            ]);
        }

        allow create, delete: if isAuthenticated();
        allow update: if isAuthenticated() || isPublicBroadcastViewerUpdate();

        match /viewers/{viewerId} {
          allow read, write: if true;
        }
      }

      match /songs/{songId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /courses/{courseId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin(churchId);
      }

      match /quickCards/{cardId} {
        allow read: if true;
        allow write: if isChurchAdmin(churchId);
      }

      match /brands/{brandId} {
        allow read: if true;
        allow write: if isChurchAdmin(churchId);
      }

      match /categories/{categoryId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin(churchId);
      }

      match /members/{memberId} {
        allow read, write, delete: if isChurchAdmin(churchId);
      }

      match /visitors/{visitorId} {
        allow create: if isAuthenticated() && isChurchAdmin(churchId);
        allow read, update, delete: if isChurchAdmin(churchId);
      }

      match /config/process {
        allow read, write: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // Mi Organizacion module layout/visibility settings
      match /settings/{settingId} {
        allow read: if isAuthenticated() && (isUserInChurch(churchId) || isGlobalAdmin());
        allow write: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // Work Progress sheet type catalog/settings
      match /workProgressSettings/{settingId} {
        allow read: if canReadModule(churchId, 'commitments');
        allow write: if canManageModule(churchId, 'commitments');
      }
      
      // Social Media permissions - allow admin role to CRUD
      match /socialMedia/{postId} {
        allow read, write, create, update, delete: if isChurchAdmin(churchId);
      }
      
      // Social Media Accounts permissions - allow admin role to CRUD
      match /socialMediaAccounts/{accountId} {
        allow read, write, create, update, delete: if isChurchAdmin(churchId);
      }
      
      // Forms - Admin can manage forms, anyone can submit entries
      match /forms/{formId} {
        allow read: if isAuthenticated() || (resource.data.isActive == true);
        allow write, create, update, delete: if isChurchAdmin(churchId);
        
        // Form entries - COMPLETELY OPEN for submissions
        match /entries/{entryId} {
          allow read, write, create, update, delete: if true;
        }
      }

      // EZLink redirects must be publicly readable for QR scans by unauthenticated users.
      match /ezlinks/{slug} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && isChurchAdmin(churchId);

        // Hit logs should remain internal to authenticated church users/admins.
        match /hitLogs/{hitId} {
          allow read: if isAuthenticated() && (isUserInChurch(churchId) || isGlobalAdmin());
          allow write, create, update, delete: if false;
        }
      }
      
      // Time Tracking - Users can CRUD their own entries, anyone in church can read
      match /timeEntries/{entryId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow write, create, update, delete: if isAuthenticated() && 
          (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isChurchAdmin(churchId));
      }

      // TimeRotate logs - users can create/edit/delete their own entries, church admins can manage all
      match /timeRotateLogs/{logId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create: if isAuthenticated() &&
          (request.resource.data.userId == request.auth.uid || isChurchAdmin(churchId));
        allow update, delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isChurchAdmin(churchId));
      }

      // TimeRotate task details (tags/project overrides/completion status)
      match /timeRotateTaskDetails/{taskId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create: if isAuthenticated() &&
          (
            request.resource.data.updatedByUid == request.auth.uid ||
            isChurchAdmin(churchId)
          );
        allow update, delete: if isAuthenticated() &&
          (
            resource.data.updatedByUid == request.auth.uid ||
            request.resource.data.updatedByUid == request.auth.uid ||
            isChurchAdmin(churchId)
          );
      }

      // TimeRotate edit/audit logs - church users can read, church users can append, admins can manage all.
      match /timeRotateEditLogs/{logId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create: if isAuthenticated() &&
          (
            request.resource.data.editedBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name ||
            request.resource.data.editedBy == request.auth.token.email ||
            isUserInChurch(churchId) ||
            isChurchAdmin(churchId)
          );
        allow update, delete: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // TimeRotate active timers - church users can read active timers, owners/admins can write
      match /timeRotateActiveTimers/{timerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          (
            request.resource.data.userId == request.auth.uid ||
            request.resource.data.userEmail == request.auth.token.email ||
            request.resource.data.ownerKey == request.auth.uid ||
            request.resource.data.ownerKey == request.auth.token.email ||
            isChurchAdmin(churchId)
          );
        allow update: if isAuthenticated() &&
          (
            resource.data.userId == request.auth.uid ||
            request.resource.data.userId == request.auth.uid ||
            resource.data.userEmail == request.auth.token.email ||
            request.resource.data.userEmail == request.auth.token.email ||
            resource.data.ownerKey == request.auth.uid ||
            request.resource.data.ownerKey == request.auth.uid ||
            resource.data.ownerKey == request.auth.token.email ||
            request.resource.data.ownerKey == request.auth.token.email ||
            isChurchAdmin(churchId)
          );
        allow delete: if isAuthenticated() &&
          (
            resource.data.userId == request.auth.uid ||
            resource.data.userEmail == request.auth.token.email ||
            resource.data.ownerKey == request.auth.uid ||
            resource.data.ownerKey == request.auth.token.email ||
            isChurchAdmin(churchId)
          );
      }

      // PayEveryone user settings: owners can access their own records, managers/admins can manage all.
      match /payEveryoneUserSettings/{settingId} {
        function canReadPayEveryoneModule() {
          return canReadModule(churchId, 'pay-everyone') || canReadModule(churchId, 'time-tracker');
        }

        function canManagePayEveryoneModule() {
          return canManageModule(churchId, 'pay-everyone') || canManageModule(churchId, 'time-tracker');
        }

        function isSettingsOwnerFromResource() {
          return resource.data.userId == request.auth.uid ||
            resource.data.userEmail == request.auth.token.email ||
            resource.data.userKey == request.auth.uid ||
            resource.data.userKey == request.auth.token.email ||
            settingId == request.auth.uid;
        }

        function isSettingsOwnerFromRequest() {
          return request.resource.data.userId == request.auth.uid ||
            request.resource.data.userEmail == request.auth.token.email ||
            request.resource.data.userKey == request.auth.uid ||
            request.resource.data.userKey == request.auth.token.email ||
            settingId == request.auth.uid;
        }

        allow get: if isAuthenticated() && userBelongsToChurch(churchId) &&
          (isSettingsOwnerFromResource() || canReadPayEveryoneModule());

        // Only users with explicit module read access can query all user settings.
        allow list: if isAuthenticated() && canReadPayEveryoneModule();

        allow create: if isAuthenticated() && canReadPayEveryoneModule() &&
          (isSettingsOwnerFromRequest() || canManagePayEveryoneModule());

        allow update: if isAuthenticated() && userBelongsToChurch(churchId) &&
          (
            canManagePayEveryoneModule() ||
            (canReadPayEveryoneModule() &&
              (isSettingsOwnerFromResource() || isSettingsOwnerFromRequest()))
          );

        allow delete: if isAuthenticated() && canManagePayEveryoneModule();
      }

      // PayEveryone global settings contain sensitive values (e.g. lesson limits/PIN): managers/admins only.
      match /payEveryoneSettings/{docId} {
        allow read, create, update, delete: if isAuthenticated() &&
          (canManageModule(churchId, 'pay-everyone') || canManageModule(churchId, 'time-tracker'));
      }

      // PayEveryone payments are sensitive payroll data: managers/admins only.
      match /payEveryonePayments/{paymentId} {
        allow read, create, update, delete: if isAuthenticated() &&
          (canManageModule(churchId, 'pay-everyone') || canManageModule(churchId, 'time-tracker'));
      }

      // TimeRotate floor planner docs (state, cardBudgets) - church users can read, admins can edit
      match /timeRotateFloorPlanner/{docId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create, update, delete: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // Work Progress commitments
      match /commitments/{taskId} {
        allow read: if canReadModule(churchId, 'commitments');
        allow create, update, delete: if canManageModule(churchId, 'commitments');
      }

      // Work Progress sheet logs
      match /workProgressSheetLogs/{logId} {
        allow read: if canReadModule(churchId, 'commitments');
        allow create, update, delete: if canManageModule(churchId, 'commitments');
      }

      // Employee Expenses - Users can read their own, admins see all
      match /employeeExpenses/{expenseId} {
        allow read: if isAuthenticated() && 
          (resource.data.userId == request.auth.uid || isChurchAdmin(churchId));
        allow write, create, update, delete: if isAuthenticated() && 
          (request.resource.data.userId == request.auth.uid || isChurchAdmin(churchId));
      }

      // Salary Payments - Users can read their own, admins manage all
      match /salaryPayments/{paymentId} {
        allow read: if isAuthenticated() && 
          (resource.data.userId == request.auth.uid || isChurchAdmin(churchId));
        allow write, create, update, delete: if isAuthenticated() && 
          isChurchAdmin(churchId);
      }
      
      // Tasks - Users can CRUD their own tasks, and read all tasks in their church
      match /tasks/{taskId} {
        allow read: if isAuthenticated();
        allow write, create, update, delete: if isAuthenticated() && 
          ((resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid) || 
           (request.resource.data.userId == request.auth.uid || request.resource.data.createdBy == request.auth.uid));
        
        // Task comments - Authenticated users can CRUD comments on tasks
        match /comments/{commentId} {
          allow read, write, create, update, delete: if isAuthenticated();
        }
      }
      
      // Build Tasks - Church members can access tasks for their church
      match /buildTasks/{taskId} {
        allow read, write, create, update, delete: if isAuthenticated() && 
          isUserInChurch(resource.data.churchId);
        // Allow subcollections like comments
        match /comments/{commentId} {
          allow read, write, create, update, delete: if isAuthenticated() && 
            isUserInChurch(get(/databases/$(database)/documents/buildTasks/$(taskId)).data.churchId);
        }
      }

      // Agile Tasks - Church members can access tasks for their church
      match /agileTasks/{taskId} {
        allow read, write, create, update, delete: if isAuthenticated() &&
          (
            isUserInChurch(resource.data.churchId) ||
            isUserInChurch(request.resource.data.churchId)
          );

        match /comments/{commentId} {
          allow read, write, create, update, delete: if isAuthenticated() &&
            isUserInChurch(get(/databases/$(database)/documents/agileTasks/$(taskId)).data.churchId);
        }

        match /activity/{activityId} {
          allow read, write, create, update, delete: if isAuthenticated() &&
            isUserInChurch(get(/databases/$(database)/documents/agileTasks/$(taskId)).data.churchId);
        }
      }
      
      // Task Progress - Users can CRUD their own progress entries
      match /taskProgress/{progressId} {
        allow read, write, create, update, delete: if isAuthenticated() && 
          (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      }
      
      // Submissions - Users can CRUD their own submissions
      match /submissions/{submissionId} {
        allow read, write, create, update, delete: if isAuthenticated() && 
          (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      }
      
      // Projects - Authenticated users can read all projects in any church
      match /projects/{projectId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && 
          (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      }
      
      // Areas of Focus - Authenticated users can read all areas in any church
      match /areasOfFocus/{areaId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && 
          (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      }
      
      // Cost Codes - Authenticated users can read all cost codes in any church
      match /costCodes/{costCodeId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && 
          (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      }
      
      // Brands (BIM Tracker) - Authenticated users can read and write
      match /brands/{brandId} {
        allow read: if true;
        allow write, create, update, delete: if isAuthenticated();
      }

      // BIM Projects - Authenticated users can read and write
      match /bimProjects/{projectId} {
        allow read: if true;
        allow write, create, update, delete: if isAuthenticated();

        // Agile dashboard reads and updates issue docs from this subcollection.
        match /issues/{issueId} {
          allow read: if true;
          allow write, create, update, delete: if isAuthenticated();
        }

        match /uploadLogs/{logId} {
          allow read: if true;
          allow write, create, update, delete: if isAuthenticated();
        }

        match /rows/{rowId}/comments/{commentId} {
          allow read: if true;
          allow write, create, update, delete: if isAuthenticated();
        }
      }

      // Catalogs for dropdowns (per church)
      match /catalogs/{catalogId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create, update, delete: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // Collection metadata (per church)
      match /collectionMetadata/{metaId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create, update, delete: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // Donor settings (role catalogs, etc.)
      match /donorSettings/{settingId} {
        allow read: if isAuthenticated() && isUserInChurch(churchId);
        allow create, update, delete: if isAuthenticated() && isChurchAdmin(churchId);
      }

      // Evangelism Outreach contacts: public page where anyone can view and add contacts.
      match /evangelismOutreachContacts/{contactId} {
        allow read, write, create, update, delete: if true;
      }

      // Project Lists & Issues module — public read, auth required to write
      match /projectListIssueProjects/{projectId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();

        match /buckets/{bucketId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();
        }

        match /dayCountLogs/{logId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();
        }

        match /issues/{issueId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();
        }

        match /lists/{listId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();

          match /issues/{issueId} {
            allow read: if true;
            allow create, update, delete: if isAuthenticated();
          }
        }
      }

      match /projectListIssueBuckets/{bucketId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }

      // Conduit Run Counter data - church users with module read access can view;
      // users with manage/create/update/delete permission can modify.
      match /conduitRunCounterProjects/{projectId} {
        allow read: if canReadModule(churchId, 'conduit-run-counter');
        allow create, update, delete: if canManageModule(churchId, 'conduit-run-counter');

        match /rows/{rowId} {
          allow read: if canReadModule(churchId, 'conduit-run-counter');
          allow create, update, delete: if canManageModule(churchId, 'conduit-run-counter');
        }
      }
    }

    // ✅ Visitors Collection (Top-level)
    match /visitors/{churchId}/visitors/{visitorId} {
      // Allow admins and authenticated users to read/query visitors in their church
      allow read, list: if isAuthenticated() && 
        (isChurchAdmin(churchId) || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId);
      // Allow admins and authenticated users to create/update visitors
      allow create, update: if isAuthenticated() && 
        (isChurchAdmin(churchId) || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId);
      // Only admins can delete
      allow delete: if isChurchAdmin(churchId);
    }

    // ✅ Completion Logs
    match /completionLogs/{logId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isUserInChurch(resource.data.churchId));
      allow write: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         isUserInChurch(request.resource.data.churchId));
    }

    // ✅ Categories
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
    }

    // ✅ Courses
    match /courses/{courseId} {
      allow read: if isAuthenticated();
    }

    // ✅ Media
    match /media/{mediaId} {
      allow read: if true;
      allow write, delete: if isChurchAdmin(resource.data.churchId);
    }

    match /playlist/{playlistId} {
      allow read: if isAuthenticated();
      allow write, delete: if isChurchAdmin(resource.data.churchId);
    }

    match /syncChurchPlaylist/{syncId} {
      allow read: if isAuthenticated();
      allow write, delete: if isChurchAdmin(resource.data.churchId);
    }

    // ✅ Gallery
    match /gallery_new/{galleryId} {
      allow read: if true;
      allow write, delete: if isChurchAdmin(resource.data.churchId);
    }

    match /gallery_images/{imageId} {
      allow read: if true;
      allow write, delete: if isChurchAdmin(resource.data.churchId);
    }

    // ✅ Chats & Messaging
    match /chats/{chatId} {
      allow read, write, delete: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write, delete: if isAuthenticated();
    }

    match /chat_members/{memberId} {
      allow read, write, delete: if isAuthenticated();
    }

    // ✅ Group Messaging
    match /groups/{groupId} {
      allow read, write, delete: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write, delete: if isAuthenticated();
      }

      match /readStatus/{statusId} {
        allow read, write, delete: if isAuthenticated();
      }

      match /typingStatus/{typingId} {
        allow read, write, delete: if isAuthenticated();
      }
    }

    // ✅ Profiles
    match /{path=**}/profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && request.auth.uid == profileId;
    }

    // ✅ Reference Data
    match /{collection}/{docId} {
      allow read: if isAuthenticated() &&
        collection in ['Family', 'Nationalities', 'Profession', 'language', 'skills'];
      allow write, delete: if isGlobalAdmin();
    }

    // ✅ Event Registrations
    match /eventRegistrations/{registrationId} {
      // Anyone can read registrations
      // For public users, we use client-side filtering to limit visible fields
      allow read: if true;
      
      // Anyone can create a registration
      allow create: if true;
      
      // Only admins and global admins can update or delete registrations
      allow update, delete: if isAuthenticated() && 
        (isChurchAdmin(resource.data.churchId) || isGlobalAdmin());
    }

    // ✅ Brands (for filtering churches)
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ✅ Global Admin Override
    match /{document=**} {
      allow read, write, delete: if isGlobalAdmin();
    }
  }
}
